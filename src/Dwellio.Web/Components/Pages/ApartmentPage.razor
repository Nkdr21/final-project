@page "/apartment/{Id:int}"
@inject HousingService Housing
@inject SearchState Search
@inject IRouteProvider Routes
<PageTitle>@(listing?.Title ?? "Apartment") — Dwellio</PageTitle>
<div class="shell section">@if(loading){<p>Loading apartment…</p>}else if(listing is null || complex is null){<h1>Listing not found</h1><a href="/catalog">Back to results</a>}else{
<a class="text-link" href="/catalog">← Apartments in Astana</a><div class="section-heading"><div><h1>@listing.Title</h1><p><a href="/complex/@complex.Id">@complex.Name ↗</a> · @complex.Address</p></div><button class="button secondary" @onclick="Favorite">♡ @(favorite ? "Saved" : "Save")</button></div>
<div class="detail-grid"><div><img class="detail-image" src="@listing.Photo" alt="Apartment image" /><p class="data-note">@(listing.Photo.StartsWith("/uploads/") ? "Image supplied by the listing author." : "Concept illustration, not a photograph of a real property.") @(listing.IsDemo ? "This is a demo listing, not a rental offer." : "")</p>
<div class="feature-row"><span>@listing.Rooms rooms</span><span>@listing.Area m²</span><span>@listing.Floor floor</span><span>@(listing.Furnished ? "Furnished" : "Unfurnished")</span></div><h2>About the apartment</h2><p>@listing.Description</p>
<h2>Within reach</h2><div class="nearby-list">@foreach(var a in complex.ToModel().Amenities){<div><strong>@Labels.Category(a.Category)</strong><span>@(a.WalkMinutes==0 ? "Inside the complex" : $"{a.WalkMinutes} min walk · demo")</span><small>@a.Access</small></div>}</div><a href="/complex/@complex.Id" class="text-link">Entrance, courtyard and resident reviews →</a>
<h2>Your daily commute</h2><p>Arrive by @Search.Preferences.ArrivalHour:00 · return at @Search.Preferences.ReturnHour:00 · <a href="/preferences">change</a></p><p class="data-note">Demo scenarios: times and passenger loads are synthetic. A seat on the bus is never guaranteed.</p><div class="two-columns"><TripCard Title="TO CAMPUS" Trip="outbound"/><TripCard Title="BACK HOME" Trip="back"/></div>@if(routeMessage.Length>0){<p role="status">@routeMessage</p>}
<h2>The neighbourhood</h2><MapPanel Latitude="complex.Latitude" Longitude="complex.Longitude" /></div>
<aside class="price-panel"><span class="eyebrow">MONTHLY RENT</span><h2>@Labels.Money(listing.Rent)</h2><p>@(listing.Available ? "Available according to listing" : "No longer available")</p><hr/><div class="cost-row"><span>Utilities</span><strong>@(listing.Utilities.HasValue ? Labels.Money(listing.Utilities.Value) : "Not provided")</strong></div><div class="cost-row"><span>Transport · your estimate</span><strong>@Labels.Money(Search.Preferences.TransportCost)</strong></div><div class="cost-row"><span>Separate gym membership</span><strong>@Labels.Money(cost!.GymCost)</strong></div><div class="cost-row total"><span>@(cost.UtilitiesUnknown ? "Known costs" : "Monthly estimate")</span><strong>@Labels.Money(cost.KnownTotal)</strong></div>@if(cost.UtilitiesUnknown){<p class="data-note">Utilities are excluded because their cost is unknown.</p>}<div class="cost-row"><span>One-time deposit</span><strong>@Labels.Money(cost.Deposit)</strong></div><small>Move-in estimate: @(cost.UtilitiesUnknown ? "from " : "")@Labels.Money(cost.MoveInTotal). Costs are estimates.</small><hr/><button class="button full" @onclick="Compare">@(Search.CompareIds.Contains(Id) ? "Remove from comparison" : "Add to comparison")</button><a href="/compare" class="text-link">Open comparison →</a><p role="status">@message</p><h3>Contact</h3><p>@(string.IsNullOrWhiteSpace(listing.Contact)?"No contact provided":listing.Contact)</p><small>Updated: @listing.UpdatedUtc.ToString("dd.MM.yyyy") UTC</small>
@if(match is not null){<hr/><h3>@match.Score / 100 for your priorities</h3>@foreach(var reason in match.Reasons){<p class="reason">✓ @reason</p>}@foreach(var missing in match.Missing){<p class="muted">· @missing</p>}}else{<p>Does not meet your current must-haves or commute limits.</p>}</aside></div>}
</div>
@code{
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Search.LoadComparisonAsync();
        StateHasChanged();
    }

 [Parameter]public int Id{get;set;} ListingEntity? listing; ComplexEntity? complex; MonthlyCost? cost; Match? match;Trip? outbound,back;bool loading=true,favorite;string message="",routeMessage="";
 protected override async Task OnParametersSetAsync(){loading=true;if(!Search.Loaded)Search.Update(await Housing.LoadPreferences()??new());listing=await Housing.Listing(Id);complex=(await Housing.Complexes()).FirstOrDefault(x=>x.Id==listing?.ComplexId);if(listing is not null&&complex is not null){cost=RecommendationEngine.CalculateCost(listing.ToModel(),complex.ToModel(),Search.Preferences);var route=await Routes.GetAsync(complex.ToModel(),Search.Preferences);match=RecommendationEngine.Evaluate(listing.ToModel(),complex.ToModel(),Search.Preferences,route);if(route is RoutesFound found){outbound=RecommendationEngine.ChooseTrip(found.Value.Outbound,Search.Preferences);back=RecommendationEngine.ChooseTrip(found.Value.Return,Search.Preferences);}else routeMessage=route switch{RoutesMissing r=>r.Message,RoutesUnavailable r=>r.Message,_=>"No data"};favorite=(await Housing.Favorites()).Contains(Id);}loading=false;}
 async Task Favorite(){message=(await Housing.ToggleFavorite(Id)).Message;favorite=(await Housing.Favorites()).Contains(Id);}
 async Task Compare()=>message=(await Search.ToggleCompareAsync(Id)).Message;
}
