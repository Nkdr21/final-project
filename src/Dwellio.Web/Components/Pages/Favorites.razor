@page "/favorites"
@attribute [Authorize]
@inject HousingService Housing
@inject HomeFinder Finder

<PageTitle>Saved homes — Dwellio</PageTitle>

<div class="shell page">
    <span class="eyebrow">Your shortlist</span>
    <h1>Saved homes</h1>
    @if (items.IsEmpty)
    {
        <EmptyState Emoji="♡" Title="Nothing saved yet">
            <p class="muted">Open a home and tap ♡ Save to keep it here on every device.</p>
            <a class="button" href="/plan">Find homes</a>
        </EmptyState>
    }
    <div class="grid-3">
        @foreach (var item in items)
        {
            <div class="stack" @key="item.Listing.Id">
                <HomeCard Result="item" Selected="State.CompareIds.Contains(item.Listing.Id)" OnCompare="Compare" />
                <button class="button small ghost" @onclick="() => Remove(item.Listing.Id)">Remove from saved</button>
            </div>
        }
    </div>
    <p role="status" class="status">@message</p>
</div>

@code {
    [CascadingParameter] public PlannerState State { get; set; } = default!;
    [CascadingParameter] public Preferences Plan { get; set; } = default!;
    private ImmutableArray<HomeResult> items = [];
    private string message = "";

    protected override async Task OnParametersSetAsync()
    {
        var ids = await Housing.Favorites();
        items = (await Finder.RankAsync(Plan)).Where(r => ids.Contains(r.Listing.Id)).ToImmutableArray();
    }

    private async Task Compare(int id) => message = (await State.ToggleCompareAsync(id)).Message;

    private async Task Remove(int id)
    {
        message = (await Housing.ToggleFavorite(id)).Message;
        items = items.RemoveAll(x => x.Listing.Id == id);
    }
}
