@page "/owner/edit/{Id:int}"
@attribute [Authorize(Roles = "Owner,Admin")]
@inject HousingService Housing
@inject IWebHostEnvironment Environment

<PageTitle>@(Id == 0 ? "New listing" : "Edit listing") — Dwellio</PageTitle>

<div class="shell page narrow">
    <a href="/owner">← My listings</a>
    <h1 style="margin-top:12px">@(Id == 0 ? "New listing" : "Edit listing")</h1>
    @if (!ready)
    {
        <p class="callout bad">@message</p>
    }
    else
    {
        <EditForm Model="model" OnValidSubmit="Save" FormName="listing" class="panel stack">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-errors" />
            <div class="form-grid">
                <label class="field">Title<InputText @bind-Value="model.Title" /></label>
                <label class="field">Residential complex
                    <InputSelect @bind-Value="model.ComplexId">
                        <option value="0">Choose a complex</option>
                        @foreach (var c in complexes) { <option value="@c.Id">@c.Name</option> }
                    </InputSelect>
                </label>
                <label class="field">Rent, ₸ / month<InputNumber @bind-Value="model.Rent" /></label>
                <label class="field">Utilities, ₸ <small>(empty = unknown)</small><InputNumber @bind-Value="model.Utilities" /></label>
                <label class="field">Deposit, ₸ <small>(empty = unknown)</small><InputNumber @bind-Value="model.Deposit" /></label>
                <label class="field">Rooms<InputNumber @bind-Value="model.Rooms" /></label>
                <label class="field">Area, m²<InputNumber @bind-Value="model.Area" /></label>
                <label class="field">Floor<InputNumber @bind-Value="model.Floor" /></label>
                <label class="field">Contact<InputText @bind-Value="model.Contact" /></label>
            </div>
            <label class="field">Description<InputTextArea @bind-Value="model.Description" /></label>
            <div class="inline">
                <label class="check"><InputCheckbox @bind-Value="model.Furnished" /> Furnished</label>
                <label class="check"><InputCheckbox @bind-Value="model.Available" /> Listing is active</label>
            </div>
            <label class="field">Main photo — JPEG or PNG, up to 5 MB<InputFile OnChange="Upload" accept="image/jpeg,image/png" /></label>
            <p class="note">Only upload photos you have the right to publish. They are visible to everyone.</p>
            <ListingPhoto Url="@model.Photo" Alt="Photo preview" Class="upload-preview" />
            <p role="status" class="status @(error ? "error" : "")">@message</p>
            <div class="inline">
                <button class="button" type="submit" disabled="@saving">@(saving ? "Saving…" : "Save listing")</button>
                <a class="button ghost" href="/owner">Cancel</a>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private ListingEntity model = new();
    private List<ComplexEntity> complexes = [];
    private bool ready, saving, error;
    private string message = "";

    protected override async Task OnParametersSetAsync()
    {
        complexes = await Housing.Complexes();
        if (Id == 0) { model = new(); ready = true; return; }
        var item = (await Housing.Listings(own: true)).FirstOrDefault(x => x.Id == Id);
        if (item is null) { message = "This listing is not in your account."; ready = false; }
        else { model = item; ready = true; }
    }

    private async Task Save()
    {
        saving = true;
        try
        {
            var result = await Housing.SaveListing(model);
            (message, error) = (result.Message, !result.Success);
        }
        catch (Exception e) when (e is Microsoft.EntityFrameworkCore.DbUpdateException or InvalidOperationException)
        {
            (message, error) = ("Could not save. Check the form and try again.", true);
        }
        finally { saving = false; }
    }

    private async Task Upload(InputFileChangeEventArgs e)
    {
        const long max = 5 * 1024 * 1024;
        try
        {
            if (e.File.Size > max) { (message, error) = ("Maximum file size is 5 MB.", true); return; }
            using var memory = new MemoryStream();
            await e.File.OpenReadStream(max).CopyToAsync(memory);
            var bytes = memory.ToArray();
            // Check the file signature, not the name: only real PNG/JPEG files are stored.
            bool png = bytes.Length > 8 && bytes.AsSpan(0, 8).SequenceEqual(new byte[] { 137, 80, 78, 71, 13, 10, 26, 10 });
            bool jpeg = bytes.Length > 3 && bytes[0] == 255 && bytes[1] == 216 && bytes[2] == 255;
            if (!png && !jpeg) { (message, error) = ("Only JPEG and PNG images are supported.", true); return; }
            var folder = Path.Combine(Environment.WebRootPath, "uploads");
            Directory.CreateDirectory(folder);
            var name = Guid.NewGuid().ToString("N") + (png ? ".png" : ".jpg");
            await File.WriteAllBytesAsync(Path.Combine(folder, name), bytes);
            model.Photo = "/uploads/" + name;
            (message, error) = ("Photo uploaded. Save the listing to attach it.", false);
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException)
        {
            (message, error) = ("Could not upload the photo. Try again.", true);
        }
    }
}
