@page "/owner/edit/{Id:int}"
@attribute [Authorize(Roles="Owner,Admin")]
@inject HousingService Housing
@inject IWebHostEnvironment Environment
<PageTitle>Listing — Dwellio</PageTitle>
<div class="shell section narrow"><h1>@(Id==0?"New listing":"Edit listing")</h1>@if(ready){<EditForm Model="model" OnValidSubmit="Save" FormName="listing"><DataAnnotationsValidator/><ValidationSummary/><div class="form-grid"><label>Title<InputText @bind-Value="model.Title"/></label><label>Complex<InputSelect @bind-Value="model.ComplexId"><option value="0">Choose complex</option>@foreach(var c in complexes){<option value="@c.Id">@c.Name</option>}</InputSelect></label><label>Rent, KZT<InputNumber @bind-Value="model.Rent"/></label><label>Utilities, KZT (blank = unknown)<InputNumber @bind-Value="model.Utilities"/></label><label>Deposit, KZT<InputNumber @bind-Value="model.Deposit"/></label><label>Rooms<InputNumber @bind-Value="model.Rooms"/></label><label>Area, m²<InputNumber @bind-Value="model.Area"/></label><label>Floor<InputNumber @bind-Value="model.Floor"/></label><label>Contact<InputText @bind-Value="model.Contact"/></label></div><label>Description<InputTextArea @bind-Value="model.Description"/></label><div class="feature-row"><label class="check"><InputCheckbox @bind-Value="model.Furnished"/> Furnished</label><label class="check"><InputCheckbox @bind-Value="model.Available"/> Listing is active</label></div><label>Main photo — JPEG or PNG, up to 5 MB<InputFile OnChange="Upload" accept="image/jpeg,image/png"/></label><p class="data-note">Only upload images you have permission to publish. The image will be visible to app visitors.</p><img class="upload-preview" src="@model.Photo" alt="Image preview"/><p role="status">@message</p><button class="button" type="submit" disabled="@saving">@(saving?"Saving…":"Save listing")</button><a class="text-link" href="/owner">Back to dashboard</a></EditForm>}else{<p>@message</p>}</div>
@code{
 [Parameter]public int Id{get;set;}ListingEntity model=new();List<ComplexEntity> complexes=[];bool ready,saving;string message="";
 protected override async Task OnParametersSetAsync(){complexes=await Housing.Complexes();if(Id==0){model=new();ready=true;}else{var mine=await Housing.Listings(own:true);var item=mine.FirstOrDefault(x=>x.Id==Id);if(item is null){message="Listing not found in your account.";ready=false;}else{model=item;ready=true;}}}
 async Task Save(){saving=true;try{message=(await Housing.SaveListing(model)).Message;}catch(Exception){message="Could not save. Check the form and try again.";}finally{saving=false;}}
 async Task Upload(InputFileChangeEventArgs e){try{var file=e.File;if(file.Size>5*1024*1024){message="Maximum file size is 5 MB.";return;}using var memory=new MemoryStream();await file.OpenReadStream(5*1024*1024).CopyToAsync(memory);var bytes=memory.ToArray();bool png=bytes.Length>8&&bytes.AsSpan(0,8).SequenceEqual(new byte[]{137,80,78,71,13,10,26,10});bool jpeg=bytes.Length>3&&bytes[0]==255&&bytes[1]==216&&bytes[2]==255;if(!png&&!jpeg){message="Only JPEG and PNG files are supported.";return;}var folder=Path.Combine(Environment.WebRootPath,"uploads");Directory.CreateDirectory(folder);var name=Guid.NewGuid().ToString("N")+(png?".png":".jpg");await File.WriteAllBytesAsync(Path.Combine(folder,name),bytes);model.Photo="/uploads/"+name;message="Image uploaded. Save the listing to attach it.";}catch(Exception){message="Could not upload image.";}}
}
