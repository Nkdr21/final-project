@page "/compare"
@inject HomeFinder Finder

<PageTitle>Compare homes — Dwellio</PageTitle>

<div class="shell page">
    <span class="eyebrow">Side by side</span>
    <h1>Compare homes</h1>
    <p class="lead">Rent is only part of it. Compare monthly costs, everyday places and the trip to @Plan.DestinationName.</p>
    @if (loading)
    {
        <div class="compare-grid">@for (var i = 0; i < 2; i++) { <div class="skeleton" style="height:420px"></div> }</div>
    }
    else if (rows.IsEmpty)
    {
        <EmptyState Emoji="⚖️" Title="Nothing to compare yet">
            <p class="muted">Tap ⚖️ on up to @PlannerState.MaxCompare homes in the planner.</p>
            <a class="button" href="/plan">Find homes</a>
        </EmptyState>
    }
    else
    {
        <div class="compare-grid section">
            @foreach (var row in rows)
            {
                var cost = HomeMatcher.Cost(row.Listing.ToModel(), Plan);
                var best = rows.Count(r => r.Match.Eligible) > 1 && row.Match.Eligible && row.Match.Score == rows.Where(r => r.Match.Eligible).Max(r => r.Match.Score);
                <article class="panel stack @(best ? "option best" : "")" @key="row.Listing.Id">
                    <ListingPhoto Url="@row.Listing.Photo" Alt="@row.Listing.Title"><KindTag Kind="row.Listing.Kind" />@if (row.Match.Eligible) { <ScoreBadge Score="row.Match.Score" /> }</ListingPhoto>
                    @if (best) { <span class="tag info">Best fit for your plan</span> }
                    <h2 style="font-size:18px;margin:0"><a href="/homes/@row.Listing.Id">@row.Listing.Title</a></h2>
                    <dl class="facts">
                        <dt>Rent</dt><dd>@Labels.Money(row.Listing.Rent)</dd>
                        <dt>@(cost.UtilitiesUnknown ? "Known monthly costs" : "Monthly total")</dt><dd>@Labels.Money(cost.KnownTotal)@(cost.UtilitiesUnknown ? " + utilities?" : "")</dd>
                        <dt>Deposit</dt><dd>@(cost.Deposit is { } d ? Labels.Money(d) : "—")</dd>
                        <dt>Size</dt><dd>@row.Listing.Rooms rooms · @row.Listing.Area m²</dd>
                        <dt>Commute</dt><dd>@Labels.Minutes(row.Match.Commute.TotalMinutes)</dd>
                        <dt>Seat chance</dt><dd>@(row.Match.Commute is TransitPlan t ? Labels.Percent(t.Best.SeatChance) : "unknown")</dd>
                        <dt>Needs on foot</dt><dd>@row.Match.Area.SatisfiedCount / @row.Match.Area.Needs.Length</dd>
                    </dl>
                    <div class="tags">
                        @foreach (var need in row.Match.Area.Needs)
                        {
                            <span class="tag @(need.Satisfied(Plan.WalkLimit) ? "good" : "")">@need.Category.Icon @(need.WalkMinutes is { } m ? $"{m}′" : "—")</span>
                        }
                    </div>
                    @if (!row.Match.Eligible) { <ul class="why">@foreach (var x in row.Match.Exclusions) { <li class="no">@x</li> }</ul> }
                    <button class="button ghost block" @onclick="() => Remove(row.Listing.Id)">Remove</button>
                </article>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter] public PlannerState State { get; set; } = default!;
    [CascadingParameter] public Preferences Plan { get; set; } = default!;
    private ImmutableArray<HomeResult> rows = [];
    private bool loading = true;
    private string key = "";

    protected override async Task OnParametersSetAsync()
    {
        var next = $"{Plan.CacheKey}|{string.Join(',', State.CompareIds)}";
        if (next == key) return;
        key = next;
        var results = new List<HomeResult>();
        foreach (var id in State.CompareIds)
            if (await Finder.ForListingAsync(id, Plan) is { } r) results.Add(r);
        rows = [.. results];
        loading = false;
    }

    private async Task Remove(int id)
    {
        await State.ToggleCompareAsync(id);
        rows = rows.RemoveAll(r => r.Listing.Id == id);
    }
}
