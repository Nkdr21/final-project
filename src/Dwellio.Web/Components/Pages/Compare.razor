@page "/compare"
@inject SearchState Search
@inject HousingService Housing
@inject IRouteProvider Routes
<PageTitle>Compare — Dwellio</PageTitle>
<div class="shell section"><h1>Compare homes</h1><p>Published rental examples and demo lifestyle calculations are shown separately.</p></div>
<SourceComparison />
<details class="shell demo-catalog" open="@(items.Count > 0)"><summary>Demo lifestyle comparison</summary>
<div class="shell section"><span class="eyebrow">A THOUGHTFUL CHOICE</span><h2>Three places. Your choice.</h2><p class="intro">Compare more than rent. Picture your everyday in each home.</p>@if(items.Count==0){<div class="empty"><h2>Add homes to compare</h2><p>Select + on a listing card. Choose up to three apartments.</p><a class="button" href="/catalog">Explore homes ↗</a></div>}else{<p class="data-note">Journeys and amenities are demo scenarios. Unknown costs are not treated as zero: incomplete totals are labelled.</p><div class="comparison-grid">@foreach(var x in items){<article class="comparison-item"><img src="@x.Listing.Photo" alt="Apartment illustration"/><div class="card-body"><h2><a href="/apartment/@x.Listing.Id">@x.Complex.Name</a></h2><p>@x.Listing.Title</p><dl><dt>Rent</dt><dd>@Labels.Money(x.Listing.Rent)</dd><dt>@(x.Cost.UtilitiesUnknown?"Known part of monthly costs":"Estimated monthly total")</dt><dd>@Labels.Money(x.Cost.KnownTotal) @(x.Cost.UtilitiesUnknown?"+ unknown utilities":"")</dd><dt>Deposit</dt><dd>@Labels.Money(x.Cost.Deposit)</dd><dt>Outbound / return · demo</dt><dd>@(x.Match?.Outbound is null?"No suitable data":$"{x.Match.Outbound.Minutes} / {x.Match.Return?.Minutes} minutes")</dd><dt>Transfers outbound / return</dt><dd>@(x.Match?.Outbound is null?"—":$"{x.Match.Outbound.Transfers} / {x.Match.Return?.Transfers}")</dd><dt>Preference score</dt><dd>@(x.Match is null?"Does not meet requirements":$"{x.Match.Score} / 100")</dd></dl><div class="amenity-tags">@foreach(var a in x.Complex.ToModel().Amenities){<span>@Labels.Category(a.Category) · @a.WalkMinutes min</span>}</div><button class="button secondary full" @onclick="()=>Remove(x.Listing.Id)">Remove from comparison</button></div></article>}</div><a class="text-link" href="/preferences">Adjust priorities and recalculate →</a>}</div>
</details>
@code{record Row(ListingEntity Listing,ComplexEntity Complex,MonthlyCost Cost,Match? Match);List<Row> items=[];protected override async Task OnInitializedAsync(){await LoadItems();}
protected override async Task OnAfterRenderAsync(bool firstRender){if(!firstRender)return;await Search.LoadComparisonAsync();await LoadItems();StateHasChanged();}
async Task LoadItems(){items.Clear();if(!Search.Loaded)Search.Update(await Housing.LoadPreferences()??new());var complexes=await Housing.Complexes();foreach(var id in Search.CompareIds){var l=await Housing.Listing(id);if(l is null)continue;var c=complexes.First(x=>x.Id==l.ComplexId);var r=await Routes.GetAsync(c.ToModel(),Search.Preferences);items.Add(new(l,c,RecommendationEngine.CalculateCost(l.ToModel(),c.ToModel(),Search.Preferences),RecommendationEngine.Evaluate(l.ToModel(),c.ToModel(),Search.Preferences,r)));}}async Task Remove(int id){await Search.ToggleCompareAsync(id);items.RemoveAll(x=>x.Listing.Id==id);}}
