@page "/"
@inject HousingService Housing
@inject SearchState Search
<PageTitle>Dwellio — homes for your everyday</PageTitle>
<section class="hero shell"><div class="hero-copy"><span class="eyebrow"><span class="green-dot"></span> ASTANA · A HOME FOR YOUR EVERYDAY</span><h1>Not just an apartment.<br /><em>Your kind of place.</em></h1><p>A gym around the corner, a favourite park and an easier commute. Find a home that fits the way you live.</p><div class="hero-actions"><a class="button" href="/preferences">Find my fit <span>↗</span></a><a class="text-link" href="/catalog">Explore apartments →</a></div><div class="hero-note"><span>01 /</span><p>Your everyday comes first.<br /><strong>Your address comes next.</strong></p></div></div><div class="hero-art"><img src="/images/hero.svg" alt="Illustrated bright living room with plants and a city view" fetchpriority="high" /><div class="floating-label"><span class="green-dot"></span> Your everyday, within reach<br /><small>Move · study · unwind</small></div><div class="hero-caption">LIVE WELL, EVERY DAY.</div></div></section>
<section class="value-strip shell"><div><span>⌂</span><p><strong>Home meets neighbourhood</strong><small>Look beyond the front door</small></p></div><div><span>↗</span><p><strong>An easier daily commute</strong><small>Mornings and evenings considered</small></p></div><div><span>◎</span><p><strong>Your priorities, explained</strong><small>Know why a place fits</small></p></div></section>
<section class="shell section"><div class="section-heading"><div><span class="eyebrow">A FEW PLACES TO START</span><h2>Room for your next chapter</h2></div><a class="text-link" href="/catalog">All apartments ↗</a></div><p class="data-note">Study collection: fictional listings and complexes, with concept illustrations.</p><div class="cards">@foreach (var item in listings) { <ApartmentCard Listing="item" Complex="complexes.First(c => c.Id == item.ComplexId)" Selected="Search.CompareIds.Contains(item.Id)" OnCompare="Compare" /> }</div><p role="status">@message</p></section>
<section class="shell lifestyle-section"><div><span class="eyebrow">A NEIGHBOURHOOD THAT GETS YOU</span><h2>What does your<br />everyday look like?</h2><p>Everyone has a different idea of nearby. Tell us what matters and we will factor it in.</p><a class="button secondary" href="/preferences">Set my priorities ↗</a></div><div class="lifestyle-grid"><a href="/preferences"><span>↗</span><strong>Gym after class</strong><small>Keep moving</small></a><a href="/preferences"><span>☀</span><strong>A moment in the park</strong><small>Green space and fresh air</small></a><a href="/preferences"><span>▦</span><strong>A place to focus</strong><small>Study spaces and quiet corners</small></a><a href="/preferences"><span>⌁</span><strong>Fewer changes</strong><small>A more comfortable commute</small></a></div></section>
@code {
    List<ListingEntity> listings = []; List<ComplexEntity> complexes = []; string message = "";
    protected override async Task OnInitializedAsync() { complexes = await Housing.Complexes(); listings = (await Housing.Listings()).OrderBy(x => x.Id).Where(x => x.Id % 5 == 1).Take(3).ToList(); }
    void Compare(int id) => message = Search.ToggleCompare(id).Message;
}
