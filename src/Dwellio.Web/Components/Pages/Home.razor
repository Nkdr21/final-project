@page "/"
<PageTitle>Student housing in Astana — Dwellio</PageTitle>
<section class="housing-intro shell">
    <span class="eyebrow">ASTANA · STUDENT HOUSING</span>
    <h1>Find a home that fits your life.</h1>
    <p>Compare rent, everyday essentials and the trips you make most.</p>
    <div class="home-search">
        <div><strong>Rent an apartment</strong><span>Astana · sourced prices and listing links</span></div>
        <a class="button" href="/catalog">Browse apartments</a>
        <a class="button secondary" href="/preferences">Set budget &amp; priorities</a>
    </div>
    <div class="home-links"><a href="/complexes">Explore residential complexes →</a><a href="/compare">Open comparison →</a></div>
</section>
<section class="shell section">
    <div class="section-heading"><div><span class="eyebrow">APARTMENTS</span><h2>Explore sourced homes</h2></div><a class="text-link" href="/catalog">View all apartments →</a></div>
    <p class="data-note">Published rental examples, not a live availability feed. Confirm prices and terms with the original advertiser.</p>
    <div class="cards">@foreach (var home in MarketReferences.All.Where(x => !x.Archived && x.PhotoUrl is not null).Take(3)) { <MarketCard Home="home" Changed="Refresh" /> }</div>
</section>
<section class="shell housing-guide">
    <h2>Check more than the monthly rent</h2>
    <div class="guide-grid">
        <div><h3>Monthly costs</h3><p>Compare rent, utilities, transport and your gym budget. Keep the one-time deposit separate.</p></div>
        <div><h3>Everyday essentials</h3><p>Look for groceries, a pharmacy, a park and places to study or exercise.</p></div>
        <div><h3>Travel both ways</h3><p>Compare morning and evening journey scenarios. Live bus occupancy is not available.</p></div>
    </div>
</section>
@code { void Refresh() => StateHasChanged(); }
