@page "/preferences"
@inject SearchState Search
@inject HousingService Housing
@inject NavigationManager Nav
<PageTitle>My lifestyle — Dwellio</PageTitle>
<div class="shell section narrow"><span class="eyebrow">MADE FOR YOUR EVERYDAY</span><h1>What makes a home yours?</h1><p class="intro">Set your budget, local essentials and daily commute. You can change your priorities anytime.</p>
<div class="form-section"><h2><span>01</span> The essentials</h2><div class="form-grid"><label>Maximum rent, KZT<input type="number" min="10000" step="10000" @bind="budget" /></label><label>Minimum rooms<input type="number" min="1" max="6" @bind="rooms" /></label><label class="check"><input type="checkbox" @bind="furnished" /> Furnished only</label></div></div>
<div class="form-section"><h2><span>02</span> Your everyday essentials nearby</h2><label>Preferred walking time: @walk minutes<input type="range" min="5" max="30" step="5" @bind="walk" /></label><div class="preference-grid">@foreach (var c in Labels.Categories) { <div class="preference-option"><label class="check"><input type="checkbox" checked="@wanted.Contains(c.Key)" @onchange="e => Toggle(wanted,c.Key,e)" /> @c.Value</label><label class="check subtle"><input type="checkbox" checked="@required.Contains(c.Key)" @onchange="e => Toggle(required,c.Key,e)" /> Must-have</label></div> }</div><small>Must-haves exclude unsuitable places. Nice-to-haves influence the ranking.</small></div>
<div class="form-section"><h2><span>03</span> There and back</h2><div class="form-grid"><label>Destination<select @bind="destination"><option value="AITU">Astana IT University · scenario destination</option><option value="NU">Nazarbayev University · scenario destination</option><option value="ENU">ENU · scenario destination</option><option value="unavailable">Demo: provider unavailable</option></select></label><label>Arrive by, hour<input type="number" min="0" max="23" @bind="arrival" /></label><label>Return at, hour<input type="number" min="0" max="23" @bind="back" /></label><label>Maximum one-way minutes<input type="number" min="5" max="180" @bind="travel" /></label><label>Maximum transfers<input type="number" min="0" max="4" @bind="transfers" /></label><label>Route preference<select @bind="priority"><option value="balanced">Faster journey</option><option value="transfers">Fewer changes</option><option value="comfort">Comfort using demo data</option></select></label></div><p class="data-note">Transport is simulated for the project demonstration. This is not an Astana bus timetable.</p></div>
<div class="form-section"><h2><span>04</span> What matters most?</h2><div class="form-grid"><label>Price: @priceWeight / 5<input type="range" min="0" max="5" @bind="priceWeight" /></label><label>Neighbourhood: @lifeWeight / 5<input type="range" min="0" max="5" @bind="lifeWeight" /></label><label>Commute: @travelWeight / 5<input type="range" min="0" max="5" @bind="travelWeight" /></label></div></div>
<div class="form-section"><h2><span>05</span> Additional costs</h2><div class="form-grid"><label>Monthly transport, KZT<input type="number" min="0" @bind="transportCost" /></label><label>Separate gym membership, KZT<input type="number" min="0" @bind="gymCost" /></label></div><small>These are your estimates, not current tariffs. Gym costs are excluded when included in rent or not selected.</small></div>
<p role="status" class="status">@message</p><div class="hero-actions"><button class="button" @onclick="Apply">Show my matches ↗</button><button class="button secondary" @onclick="Save">Save to profile</button></div></div>
@code {
 decimal budget,transportCost,gymCost; int rooms,walk,arrival,back,travel,transfers,priceWeight,lifeWeight,travelWeight; bool furnished; string destination="AITU",priority="balanced",message=""; HashSet<string> wanted=[],required=[];
 protected override async Task OnInitializedAsync() { if(!Search.Loaded) Search.Update(await Housing.LoadPreferences() ?? new()); var p=Search.Preferences; budget=p.Budget;rooms=p.MinRooms;walk=p.WalkLimit;arrival=p.ArrivalHour;back=p.ReturnHour;travel=p.MaxTravelMinutes;transfers=p.MaxTransfers;priceWeight=p.PriceWeight;lifeWeight=p.LifestyleWeight;travelWeight=p.TravelWeight;furnished=p.FurnishedOnly;destination=p.Destination;priority=p.Priority;transportCost=p.TransportCost;gymCost=p.GymCost;wanted=p.Wanted.ToHashSet();required=p.Required.ToHashSet(); }
 void Toggle(HashSet<string> set,string key,ChangeEventArgs e) { if(e.Value is true) set.Add(key); else set.Remove(key); }
 Preferences Read() => new(budget,rooms,furnished,destination,arrival,back,travel,transfers,walk,priceWeight,lifeWeight,travelWeight,priority,string.Join(',',wanted.Union(required)),string.Join(',',required),transportCost,gymCost);
 void Apply() { var p=Read(); var result=RecommendationEngine.Validate(p); if(!result.Success){message=result.Message;return;} Search.Update(p);Nav.NavigateTo("/catalog"); }
 async Task Save() { var p=Read(); var valid=RecommendationEngine.Validate(p); if(!valid.Success){message=valid.Message;return;} Search.Update(p);message=(await Housing.SavePreferences(p)).Message; }
}
