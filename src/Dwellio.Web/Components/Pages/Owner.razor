@page "/owner"
@attribute [Authorize]
@inject HousingService Housing
<PageTitle>Dashboard — Dwellio</PageTitle>
<div class="shell section"><h1>My dashboard</h1><AuthorizeView Roles="Owner,Admin"><Authorized><div class="section-heading"><h2>My listings</h2><a class="button" href="/owner/edit/0">Add listing +</a></div>@if(items.Count==0){<p class="empty">No listings yet. Create your first one.</p>}@foreach(var item in items){<div class="management-row"><div><strong>@item.Title</strong><p>@Labels.Money(item.Rent) · @(item.Available?"Active":"Unavailable") @(item.Hidden?"· Hidden by moderator":"")</p></div><a class="button secondary" href="/owner/edit/@item.Id">Edit</a></div>}</Authorized><NotAuthorized><p>You have a student account. Set your preferences or explore saved homes.</p><a href="/preferences" class="button">My preferences</a><a href="/favorites" class="button secondary">Saved homes</a></NotAuthorized></AuthorizeView></div>
@code{List<ListingEntity> items=[];protected override async Task OnInitializedAsync()=>items=await Housing.Listings(own:true);}
