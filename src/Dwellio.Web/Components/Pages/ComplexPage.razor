@page "/complex/{Id:int}"
@inject HousingService Housing
@inject SearchState Search
<PageTitle>@(complex?.Name??"Complex") — Dwellio</PageTitle>
<div class="shell section">@if(complex is null){<h1>Loading, or complex not found</h1>}else{
<a href="/complexes" class="text-link">← Neighbourhoods</a><h1>@complex.Name</h1><p class="intro">@complex.Description</p><div class="complex-gallery"><figure><img src="/images/lobby.svg" alt="Concept illustration of a bright entrance lobby"/><figcaption>Lobby · illustration</figcaption></figure><figure><img src="/images/courtyard.svg" alt="Concept illustration of a green courtyard"/><figcaption>Courtyard · illustration</figcaption></figure><figure><img src="/images/gym.svg" alt="Concept illustration of a fitness space"/><figcaption>Fitness · illustration</figcaption></figure></div>
<AmenityGroup Title="Inside the complex" Items="NeighborhoodService.Inside(complex.ToModel())" />
<AmenityGroup Title="Nearby" Items="NeighborhoodService.Nearby(complex.ToModel())" />
<p class="data-note">Source: Dwellio educational dataset. Not verified on site. Walking times are example values, not street-network calculations.</p>
<h2>Apartments in this complex</h2><div class="cards">@foreach(var item in listings){<ApartmentCard Listing="item" Complex="complex" Selected="Search.CompareIds.Contains(item.Id)" OnCompare="Compare"/>}</div><p role="status">@message</p>
<h2>User reviews <small>(@reviews.Count)</small></h2><p>Residency is not verified. Reviews reflect personal experience, not an independent property inspection.</p>@if(reviews.Count==0){<p class="empty">No reviews yet. No average rating available.</p>}else{<p>Cleanliness: @reviews.Average(x=>x.Cleanliness).ToString("F1") / 5 · Quietness: @reviews.Average(x=>x.Quietness).ToString("F1") / 5 · Shared spaces: @reviews.Average(x=>x.Facilities).ToString("F1") / 5</p>@foreach(var r in reviews){<article class="review"><strong>@r.Author · @r.CreatedUtc.ToString("dd.MM.yyyy")</strong><p>@r.Text</p><small>Cleanliness @r.Cleanliness/5 · Quietness @r.Quietness/5 · Shared spaces @r.Facilities/5</small></article>}}
<AuthorizeView><Authorized><div class="form-section"><h3>Your review</h3><label>Your experience<textarea maxlength="1000" @bind="review.Text"></textarea></label><div class="form-grid"><label>Cleanliness (1–5)<input type="number" min="1" max="5" @bind="review.Cleanliness"/></label><label>Quietness (1–5)<input type="number" min="1" max="5" @bind="review.Quietness"/></label><label>Shared spaces (1–5)<input type="number" min="1" max="5" @bind="review.Facilities"/></label></div><button class="button" @onclick="SaveReview">Save review</button><p role="status">@reviewMessage</p></div></Authorized><NotAuthorized><a href="/Account/Login" class="button secondary">Sign in to review</a></NotAuthorized></AuthorizeView>
}</div>
@code{
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Search.LoadComparisonAsync();
        StateHasChanged();
    }
[Parameter]public int Id{get;set;}ComplexEntity? complex;List<ListingEntity> listings=[];List<ReviewEntity> reviews=[];ReviewEntity review=new();string message="",reviewMessage="";protected override async Task OnParametersSetAsync(){complex=(await Housing.Complexes()).FirstOrDefault(x=>x.Id==Id);listings=(await Housing.Listings()).Where(x=>x.ComplexId==Id).ToList();reviews=await Housing.Reviews(Id);review=new(){ComplexId=Id};}async Task Compare(int id)=>message=(await Search.ToggleCompareAsync(id)).Message;async Task SaveReview(){reviewMessage=(await Housing.SaveReview(review)).Message;reviews=await Housing.Reviews(Id);}}
