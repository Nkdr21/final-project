@page "/catalog"
@inject HousingService Housing
@inject SearchState Search
@inject IRouteProvider Routes
<PageTitle>Find a home — Dwellio</PageTitle>
<div class="shell section"><div class="section-heading"><div><span class="eyebrow">ASTANA / FIND YOUR HOME</span><h1>Your next chapter starts here</h1><p class="muted">Your priorities first. Your address next.</p></div><a class="button secondary" href="/preferences">My lifestyle ↗</a></div>
<div class="catalog-toolbar"><label>Rent budget, KZT<input type="number" min="10000" step="10000" @bind="budget" /></label><label>Search<input placeholder="Apartment or complex" @bind="query" @bind:event="oninput" /></label><label>Sort by<select @bind="sort"><option value="match">Best fit</option><option value="price">Lowest rent</option><option value="area">Largest space</option></select></label><button class="button" @onclick="Apply">Apply</button><button class="button secondary" @onclick="() => showMap = !showMap">@(showMap ? "Hide map" : "Show map")</button></div>
<p role="status">@message</p><div class="results-info"><strong>@Filtered.Count matches</strong><span>up to @Labels.Money(Search.Preferences.Budget) · @Search.Preferences.WalkLimit min walk to essentials</span><a href="/compare">Compare (@Search.CompareIds.Count / 3) →</a></div>
<p class="data-note">Demo data: journey times, nearby places and bus loads are scenarios, not live predictions. Scores reflect your selected weights.</p>
@if (loading) { <p>Finding your matches…</p> } else if (Filtered.Count == 0) { <div class="empty"><h2>No matches just yet</h2><p>Try a higher budget, a longer commute or fewer must-haves. Your requirements are never relaxed automatically.</p><a href="/preferences" class="button">Adjust preferences</a></div> }
@if (showMap) { <div class="map-layout"><div><label>Map location<select @bind="mapId">@foreach (var c in complexes) { <option value="@c.Id">@c.Name</option> }</select></label><MapPanel Latitude="@(complexes.FirstOrDefault(x=>x.Id==mapId)?.Latitude ?? 51.125)" Longitude="@(complexes.FirstOrDefault(x=>x.Id==mapId)?.Longitude ?? 71.43)" /></div><p class="muted">Locations are illustrative. The apartment list remains available if the map does not load.</p></div> }
<div class="cards">@foreach (var match in Filtered.Take(page * 9)) { <ApartmentCard Listing="listings.First(x => x.Id == match.Apartment.Id)" Complex="complexes.First(x => x.Id == match.Complex.Id)" Match="match" Selected="Search.CompareIds.Contains(match.Apartment.Id)" OnCompare="Compare" /> }</div>
@if (Filtered.Count > page * 9) { <button class="button secondary load-more" @onclick="() => page++">Load more</button> }</div>
@code {
    List<ListingEntity> listings = []; List<ComplexEntity> complexes = []; List<Match> matches = [];
    decimal budget; string query = "", sort = "match", message = ""; bool loading = true, showMap; int page = 1, mapId = 1;
    List<Match> Filtered { get { var items = matches.Where(x => (x.Apartment.Title + x.Complex.Name).Contains(query, StringComparison.OrdinalIgnoreCase)); return (sort switch { "price" => items.OrderBy(x=>x.Apartment.Rent), "area" => items.OrderByDescending(x=>x.Apartment.Area), _ => items.OrderByDescending(x=>x.Score).ThenBy(x=>x.Apartment.Rent) }).ToList(); } }
    protected override async Task OnInitializedAsync() { if (!Search.Loaded) Search.Update(await Housing.LoadPreferences() ?? new()); budget = Search.Preferences.Budget; complexes = await Housing.Complexes(); listings = await Housing.Listings(); await Recalculate(); }
    async Task Apply() { var p = Search.Preferences with {Budget = budget}; var result = RecommendationEngine.Validate(p); if (!result.Success) { message = result.Message; return; } Search.Update(p); page = 1; await Recalculate(); }
    async Task Recalculate() { loading = true; matches.Clear(); foreach (var c in complexes) { var route = await Routes.GetAsync(c.ToModel(), Search.Preferences); foreach (var l in listings.Where(x=>x.ComplexId==c.Id)) { var m = RecommendationEngine.Evaluate(l.ToModel(), c.ToModel(), Search.Preferences, route); if (m is not null) matches.Add(m); } } loading = false; }
    void Compare(int id) => message = Search.ToggleCompare(id).Message;
}
