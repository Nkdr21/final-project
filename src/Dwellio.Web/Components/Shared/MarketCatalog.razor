@using Dwellio.Web.Data

<div class="shell section">
    <span class="eyebrow">ASTANA / FIND YOUR HOME</span>
    <h1>Apartments in Astana</h1>
    <p class="intro">Find a home that fits your life. Compare published rent, addresses and listing details.</p>
    <p class="data-note">Sources reviewed on @MarketReferences.ReviewedOn.ToString("dd.MM.yyyy"). Search snapshots may be older. Prices and availability must be confirmed on the original listing; these are not live offers from Dwellio.</p>
    <div class="catalog-toolbar">
        <label>Complex or address<input @bind="query" @bind:event="oninput" placeholder="Search real complexes" /></label>
        <label>Maximum monthly rent, KZT<input type="number" min="1" step="10000" @bind="budget" @bind:event="oninput" aria-invalid="@(budget <= 0 ? "true" : "false")" aria-describedby="rent-validation" /></label>
        <label>Sort by<select @bind="sort"><option value="price">Lowest rent</option><option value="area">Largest area</option></select></label>
    </div>
    @if (budget <= 0)
    {
        <p id="rent-validation" role="alert">Enter a monthly rent budget greater than zero.</p>
    }
    <label class="check"><input type="checkbox" @bind="mangilikOnly" />Along Mangilik El avenue</label>
    <p class="results-info" role="status">@Filtered.Count sourced examples</p>
    @if (Filtered.Count == 0)
    {
        <div class="empty"><h2>No examples within these filters</h2><p>Try a higher budget, another complex name or turn off the avenue filter. This is a small research sample, not the whole Astana rental market.</p></div>
    }
    <div class="cards">
        @foreach (var home in Filtered)
        {
            <article class="apartment-card" @key="home.SourceUrl"><ListingPhoto Url="@home.PhotoUrl" Alt="@($"Property photo from the {home.Complex} source listing")" /><div class="card-body">
                <span class="eyebrow">SOURCE: KRISHA.KZ</span>
                <h2>@home.Complex</h2>
                @if (home.Archived) { <p class="data-note"><strong>Archived · historical price</strong></p> }
                <p>@home.Address</p>
                <p>@home.Rooms room(s) · @home.Area m²</p>
                <div class="card-bottom"><strong>@Labels.Money(home.Rent)</strong><small>/ month · asking rent</small></div>
                <dl><dt>Deposit</dt><dd>@(home.Deposit.HasValue ? Labels.Money(home.Deposit.Value) : "Not provided")</dd>
                    <dt>Utilities, transport and gym</dt><dd>Not included in this price comparison</dd></dl>
                <p class="data-note">@home.Evidence</p>
                <a class="button secondary full" href="@home.SourceUrl" target="_blank" rel="noopener noreferrer">View listing &amp; photos ↗</a>
            </div></article>
        }
    </div>
    <section class="form-section">
        <h2>What about life around the building?</h2>
        <p>BI Group describes GreenLine as a wider neighbourhood with parks, shopping and social spaces. This does not verify amenities inside every individual building, their fees or walking times.</p>
        <a class="text-link" href="https://bi.group/ru/bigville/greenline" target="_blank" rel="noopener noreferrer">Read the developer's neighbourhood description ↗</a>
        <p class="data-note">Photos are loaded from the linked listing provider and may be unavailable. Owner contacts are not imported. These references are not assigned synthetic commute scores.</p>
        <a class="button secondary" href="/preferences">Set lifestyle preferences</a>
    </section>
</div>
@code {
    private string query = "", sort = "price";
    private decimal budget = 500000;
    private bool mangilikOnly;
    private List<MarketReference> Filtered
    {
        get
        {
            var items = MarketReferences.All.Where(x => x.Rent <= budget && (!mangilikOnly || x.OnMangilikEl) &&
                (x.Complex + " " + x.Address).Contains(query, StringComparison.OrdinalIgnoreCase));
            return (sort == "area" ? items.OrderByDescending(x => x.Area) : items.OrderBy(x => x.Rent)).ToList();
        }
    }
}
