@* Photo with a graceful fallback: provider photos can disappear or be blocked. *@
<div class="photo @Class">
    @if (!string.IsNullOrWhiteSpace(Url) && !failed)
    {
        <img src="@Url" alt="@Alt" loading="lazy" referrerpolicy="no-referrer" @onerror="() => failed = true" />
    }
    else
    {
        <div class="photo-missing"><div><span aria-hidden="true">🏢</span>@(string.IsNullOrWhiteSpace(Url) ? "No photo provided" : "Photo unavailable")</div></div>
    }
    @if (ChildContent is not null) { <div class="over">@ChildContent</div> }
</div>

@code {
    [Parameter] public string? Url { get; set; }
    [Parameter] public string Alt { get; set; } = "Listing photo";
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool failed;
    private string? shown;
    protected override void OnParametersSet() { if (shown != Url) { failed = false; shown = Url; } }
}
