<article class="apartment-card">
    <a class="card-image" href="/apartment/@Listing.Id"><img src="@Listing.Photo" alt="Interior illustration: @Listing.Title" loading="lazy" width="640" height="440" /><span class="image-tag">@(Listing.IsDemo ? "Demo listing" : "Listing")</span></a>
    <div class="card-body"><div class="card-eyebrow">@Complex.Name <span>Astana</span></div><a class="card-title" href="/apartment/@Listing.Id">@Listing.Title</a>
        <p class="muted">@Listing.Rooms bed · @Listing.Area m² · @Listing.Floor floor @(Listing.Furnished ? "· furnished" : "")</p>
        <div class="amenity-tags">@foreach (var a in Complex.ToModel().Amenities.Take(3)) { <span>@Labels.Category(a.Category) · @(a.WalkMinutes == 0 ? "inside" : $"{a.WalkMinutes} min")</span> }</div>
        @if (Match is not null) { <p class="match-score">↗ @Match.Score / 100 for your priorities</p> }
        <div class="card-bottom"><div><strong>@Labels.Money(Listing.Rent)</strong><small> / month</small></div><button class="icon-button" aria-label="@(Selected ? "Remove from comparison" : "Compare apartment")" aria-pressed="@Selected" @onclick="() => OnCompare.InvokeAsync(Listing.Id)">@(Selected ? "✓" : "+")</button></div>
    </div>
</article>
@code {
    [Parameter, EditorRequired] public ListingEntity Listing { get; set; } = default!;
    [Parameter, EditorRequired] public ComplexEntity Complex { get; set; } = default!;
    [Parameter] public Match? Match { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback<int> OnCompare { get; set; }
}
