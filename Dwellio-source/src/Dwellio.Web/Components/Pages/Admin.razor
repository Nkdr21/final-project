@page "/admin"
@attribute [Authorize(Roles="Admin")]
@inject HousingService Housing
<PageTitle>Moderation — Dwellio</PageTitle>
<div class="shell section"><h1>Moderation</h1><p>Hiding is reversible. You can restore a listing or review.</p><h2>Listings</h2>@foreach(var l in listings){<div class="management-row"><span>@l.Title · @Labels.Money(l.Rent)</span><button class="button secondary" @onclick="()=>Toggle(l.Id,false)">@(l.Hidden?"Restore":"Hide")</button></div>}<h2>Reviews</h2>@foreach(var r in reviews){<div class="management-row"><span>@r.Text</span><button class="button secondary" @onclick="()=>Toggle(r.Id,true)">@(r.Hidden?"Restore":"Hide")</button></div>}<p role="status">@message</p></div>
@code{List<ListingEntity> listings=[];List<ReviewEntity> reviews=[];string message="";protected override async Task OnInitializedAsync()=>await Load();async Task Load(){listings=await Housing.Listings(admin:true);reviews=await Housing.Reviews(admin:true);}async Task Toggle(int id,bool review){message=(await Housing.Moderate(id,review)).Message;await Load();}}
