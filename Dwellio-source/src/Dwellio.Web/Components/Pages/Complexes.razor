@page "/complexes"
@inject HousingService Housing
<PageTitle>Neighbourhoods — Dwellio</PageTitle>
<div class="shell section">
    <span class="eyebrow">MORE THAN SQUARE METRES</span>
    <h1>Find your kind of neighbourhood</h1>
    <p class="intro">Entrances, courtyards, fitness and everyday essentials. Life beyond your front door.</p>
    <p class="data-note">Fictional complexes for demonstration. Names, amenities and coordinates are not verified Astana property data.</p>
    <div class="catalog-toolbar">
        <label>Complex name<input @bind="search" @bind:event="oninput" placeholder="Search neighbourhoods" /></label>
        <label>Within walking distance<select @bind="walkingLimit"><option value="5">5 minutes</option><option value="10">10 minutes</option><option value="15">15 minutes</option><option value="30">30 minutes</option></select></label>
        <button class="button secondary" @onclick="Reset">Reset filters</button>
    </div>
    <div class="feature-row">
        @foreach (var category in Labels.Categories)
        {
            <label class="check"><input type="checkbox" checked="@selected.Contains(category.Key)" @onchange="e => Toggle(category.Key, e)" />@category.Value</label>
        }
    </div>
    <p role="status">@Filtered.Count complexes match. All selected amenities are required within @walkingLimit minutes.</p>
    @if (Filtered.Count == 0)
    {
        <div class="empty"><h2>No matching neighbourhoods</h2><p>Try fewer amenities, a different name or a longer walking distance.</p></div>
    }
    <div class="cards">
        @foreach (var c in Filtered)
        {
            <article class="apartment-card">
                <a class="card-image" href="/complex/@c.Id"><img src="@c.Photo" alt="Neighbourhood concept illustration" loading="lazy" /></a>
                <div class="card-body"><span class="eyebrow">ASTANA · DEMO COMPLEX</span><h2><a href="/complex/@c.Id">@c.Name ↗</a></h2>
                    <p>@c.ToModel().Amenities.Length amenities in this scenario</p>
                    <div class="amenity-tags">@foreach (var a in c.ToModel().Amenities) { <span>@Labels.Category(a.Category) · @(a.WalkMinutes == 0 ? "inside" : $"{a.WalkMinutes} min")</span> }</div>
                </div>
            </article>
        }
    </div>
</div>
@code {
    private List<ComplexEntity> items = [];
    private string search = "";
    private int walkingLimit = 15;
    private readonly HashSet<string> selected = [];
    private List<ComplexEntity> Filtered
    {
        get
        {
            var ids = NeighborhoodService.Filter(items.Select(x => x.ToModel()), search, selected, walkingLimit)
                .Select(x => x.Id).ToHashSet();
            return items.Where(x => ids.Contains(x.Id)).OrderBy(x => x.Name).ToList();
        }
    }
    protected override async Task OnInitializedAsync() => items = await Housing.Complexes();
    private void Toggle(string key, ChangeEventArgs e)
    {
        if (e.Value is true) selected.Add(key); else selected.Remove(key);
    }
    private void Reset() { search = ""; selected.Clear(); walkingLimit = 15; }
}
